# Copiar a .env.prod (no se versiona) y cambiar TODOS los valores marcados.
POSTGRES_USER=verificacion
# OBLIGATORIO: el compose no arranca sin una contraseña. Usar una larga y única.
POSTGRES_PASSWORD=
POSTGRES_DB=verificacion
WEB_PORT=80
# HTTPS (obligatorio). La redirección de 80 a 443 asume el puerto estándar.
WEB_TLS_PORT=443
# Carpeta con server.crt y server.key (por defecto ./certs/server). Generarlos con
# scripts/generar_certificados.sh; con certificado público (VPS), apuntar a la
# carpeta que contenga copias llamadas server.crt (cadena completa) y server.key.
# CERTS_DIR=./certs/server

# manual = captura manual de lecturas. NUNCA "simulador" en producción.
EQUIPO_GATEWAY_MODO=manual

# Vacío = sin central de sincronización (cola local).
CENTRAL_SYNC_URL=
CENTRAL_SYNC_TOKEN=
